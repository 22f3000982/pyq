SECRET_KEY=replace-with-random-64-hex-characters
# Blank uses the existing local instance/app.db SQLite database.
DATABASE_URL=
# Supabase: enter the real value ONLY in your private environment.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@HOST:5432/postgres?sslmode=require
# Use the exact Dashboard connection URL (direct or session pooler).
# Percent-encode password special characters. Never commit the populated URL.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=115343360
COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
OCR_ENABLED=true

# Bulk acquisition is paused. PDF uploads still process automatically.
CATALOG_AUTO_PROCESS=false

# Private R2 S3 API credentials; keep the bucket private.
STORAGE_BACKEND=local
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PDF_BUCKET_NAME=pyq-pdfs
R2_IMAGE_BUCKET_NAME=pyq-images
R2_PREFIX=pyq

# Optional shared cache + CDN delivery (keep IMAGE_DELIVERY=proxy until CDN
# is validated against the real domain and CSP policy).
REDIS_URL=
CACHE_NAMESPACE=pyq:content:v1
CONTENT_CACHE_TTL=60
IMAGE_DELIVERY=proxy
IMAGE_CDN_BASE_URL=
IMAGE_CDN_MANIFEST=

# Optional Celery broker for bounded background ingestion.
CELERY_BROKER_URL=
CELERY_QUEUE_NAMESPACE=pyq:ingestion
